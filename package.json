{
  "name": "jev-auto-router",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/codex-router/server.js",
    "codex": "npm run build && node bin/jev-codex.mjs",
    "codex:proxy": "npm run build && node dist/src/codex-router/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {},
  "bin": {
    "jev-codex": "bin/jev-codex.mjs"
  }
}
