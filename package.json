{
  "name": "jev-auto-router",
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/codex-router/server.js",
    "codex": "npm run build && node bin/jev-codex.mjs",
    "codex:proxy": "npm run build && node dist/src/codex-router/server.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "publish:alpha": "npm run build && npm publish --tag alpha",
    "publish:latest": "npm run build && npm publish --tag latest"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {},
  "bin": {
    "jev-codex": "bin/jev-codex.mjs"
  },
  "description": "Turn-pinned model and reasoning-effort routing for Codex, powered by TypeSafe Jev.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miniLV/Jev-Auto-Router.git"
  },
  "homepage": "https://github.com/miniLV/Jev-Auto-Router",
  "bugs": {
    "url": "https://github.com/miniLV/Jev-Auto-Router/issues"
  },
  "keywords": [
    "codex",
    "jev",
    "typesafe",
    "model-routing",
    "reasoning-effort",
    "prompt-cache",
    "coding-agent"
  ],
  "files": [
    "bin",
    "dist/src",
    "docs",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
